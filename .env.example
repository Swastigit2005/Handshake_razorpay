# ---------------------------------------------------------------------------
# Copy to .env and fill in what you want to enable. Everything is optional:
# with no keys at all the batch runs fully offline and reproducibly.
# ---------------------------------------------------------------------------

# Payments: "sim" (default, offline) or "razorpay" (TEST MODE ONLY)
HS_PAYMENTS=sim
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Buyer agents: "heuristic" (default, offline) or "llm"
HS_BUYERS=heuristic

# One key, or several. A batch uses the first key until its daily quota is
# spent, then moves to the next. Keys may be from different providers.
HS_LLM_API_KEYS=
# HS_LLM_API_KEY=            # a single key also works
# HS_LLM_API_KEY_2=          # …_3 …_9 also work

HS_LLM_MODEL=
# HS_LLM_MODELS=model1,model2   # per-key models, aligned to the key order
# HS_LLM_MAX_TOKENS=256         # completion budget per decision
# HS_LLM_DAILY_QUOTA=200000     # per-key/day, used only for preflight maths

# Provider is inferred from the key, and can be forced:
#   anthropic          sk-ant-...        pip install anthropic
#   openai             sk-...            pip install openai
#   groq               gsk_...           pip install openai
#   openai_compatible  any base URL      pip install openai
# HS_LLM_PROVIDER=groq
# HS_LLM_BASE_URL=https://api.groq.com/openai/v1

# Examples
#   Groq:      HS_LLM_MODEL=openai/gpt-oss-120b   (or openai/gpt-oss-20b — faster)
#              the llama-3.x ids on Groq were retired in August 2026
#   Anthropic: HS_LLM_MODEL=claude-3-5-haiku-latest
#   OpenAI:    HS_LLM_MODEL=gpt-4o-mini
